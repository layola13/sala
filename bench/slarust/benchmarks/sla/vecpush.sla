@import "sa_std/io/print.sai"
@import "sa_std/vec.sa"

fn main() -> i32 {
    let n: i64 = 32000000;
    let v: Vec<i64> = Vec::new();
    let i: i64 = 0;
    while i < n {
        v.push(i * 3 + 1);
        i = i + 1;
    }
    let checksum: i64 = 0;
    let j: i64 = 0;
    while j < n {
        checksum = (checksum + v[j]) % 1000000007;
        j = j + 1;
    }
    println("{}", checksum);
    return 0;
}
